# Capa de compatibilidad asilivehd — SALIDA HLS por HTTPS
# Generado por instalar-compat.sh. No editar a mano.
#
# Sirve /live/<usuario>.m3u8 (+ segmentos) para el dominio migrado, con
# su propio certificado. Idéntico a la URL que ya tiene el cliente.
server {
    listen 443 ssl;
    # El asilivehd viejo servía el HLS por el puerto 3333, y los clientes tienen
    # esa URL puesta en su web, su app y sus redes. Se atiende también ahí para
    # que esos enlaces sigan vivos sin pedirles que cambien nada.
    listen 3333 ssl;
    http2 on;
    server_name {{DOMINIO_ASILIVE}};

    ssl_certificate     {{CERT_FULLCHAIN}};
    ssl_certificate_key {{CERT_KEY}};

    access_log {{LOG_DIR}}/asilive-access.log video;

    add_header 'Access-Control-Allow-Origin' '*' always;
    add_header 'Access-Control-Expose-Headers' 'Content-Length' always;

    # Alias de canales que en el servidor viejo se llamaban DISTINTO a como se
    # llaman aquí. Van en archivos sueltos y no en esta plantilla porque esta se
    # regenera con instalar-compat.sh y se llevaría los alias por delante.
    # El glob vacío no molesta a nginx, así que puede no existir ninguno.
    include cuentas/_asilive-alias/*.conf;

    # HLS: /live/<usuario>.m3u8 y sus segmentos .ts (igual que asilivehd)
    location /live {
        alias {{HLS_DIR}};
        add_header 'Cache-Control' 'no-cache' always;
        add_header 'Access-Control-Allow-Origin' '*' always;
    }

    # Reproductor propio, en la MISMA ruta que asilivehd:
    #   https://<dominio>/video/user/?user=<usuario>
    # Así los iframes ya embebidos en las webs de los clientes NO cambian,
    # pero cargan NUESTRO player (bonito y con reconexión automática).
    location = /video/user { return 301 /video/user/$is_args$args; }
    location /video/user/ {
        alias {{PLAYER_DIR}}/;
        index index.html;
        add_header 'Access-Control-Allow-Origin' '*' always;
    }

    # Subida de videos del cliente (AutoDJ): el navegador sube directo aquí con
    # un ticket firmado; se reenvía al agente, que escribe en /home/<user>/uploads.
    location /_subir {
        if ($request_method = OPTIONS) {
            add_header 'Access-Control-Allow-Origin' '*' always;
            add_header 'Access-Control-Allow-Methods' 'POST, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization, Range' always;
            add_header 'Access-Control-Max-Age' 86400 always;
            add_header 'Content-Length' 0;
            add_header 'Content-Type' 'text/plain';
            return 204;
        }
        proxy_pass http://127.0.0.1:{{PUERTO_AGENTE}}/subir;
        proxy_request_buffering off;
        proxy_http_version 1.1;
        proxy_read_timeout 3600s;
        client_max_body_size 0;
        add_header 'Access-Control-Allow-Origin' '*' always;
    }

    # Cualquier ruta que no sea de streaming (/, o desconocida) → al panel.
    # /live, /video/user y /_subir son locations más específicas y siguen igual.
    location / {
        return 301 {{PANEL_URL}}/;
    }
}
