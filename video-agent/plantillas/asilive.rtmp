# Capa de compatibilidad asilivehd — ENTRADA de video (3 apps)
# Generado por instalar-compat.sh. No editar a mano.
#
#   live        → el cliente publica aquí (usuario?token=); reenvía a asilivehls
#   asilive247  → la emisión 24/7 (AutoDJ) la empuja ffmpeg (interno); reenvía igual
#   asilivehls  → genera /live/<usuario>.m3u8 (lo que ve el público)
#
# El "vivo pisa al 24/7" lo maneja el on_publish (server.js): al entrar el vivo
# se pausa el 24/7 y se reanuda al terminar, para no pelear por asilivehls/<user>.
server {
    listen 1935;
    chunk_size 4096;
    access_log {{LOG_DIR}}/asilive-rtmp.log;

    application live {
        live on;
        on_publish http://127.0.0.1:{{PUERTO_AGENTE}}/compat/publicar;
        on_publish_done http://127.0.0.1:{{PUERTO_AGENTE}}/compat/fin;
        push rtmp://127.0.0.1:1935/asilivehls;
    }

    application asilive247 {
        live on;
        allow publish 127.0.0.1;
        deny publish all;
        push rtmp://127.0.0.1:1935/asilivehls;
    }

    application asilivehls {
        live on;
        hls on;
        hls_path {{HLS_DIR}};
        hls_fragment 3;
        hls_playlist_length 60;
        hls_nested off;
        allow publish 127.0.0.1;
        deny publish all;
    }
}
