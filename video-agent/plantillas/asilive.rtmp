# Capa de compatibilidad asilivehd — ENTRADA de video (una sola app `live`)
# Generado por instalar-compat.sh. No editar a mano.
#
# Todos los canales publican al MISMO app `live` usando su usuario como
# nombre de stream y su token como ?token=. Así el cliente conserva su
# clave "usuario?token=XXX" idéntica al sistema viejo.
server {
    listen 1935;
    chunk_size 4096;
    access_log {{LOG_DIR}}/asilive-rtmp.log;

    application live {
        live on;

        # El agente valida (usuario, token) contra compat-tokens.json
        on_publish http://127.0.0.1:{{PUERTO_AGENTE}}/compat/publicar;
        on_publish_done http://127.0.0.1:{{PUERTO_AGENTE}}/compat/fin;

        # HLS con nombres planos: <usuario>.m3u8 + <usuario>-<n>.ts
        # (para servir /live/<usuario>.m3u8 igual que asilivehd)
        hls on;
        hls_path {{HLS_DIR}};
        hls_fragment 3;
        hls_playlist_length 60;
        hls_nested off;
    }
}
